rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Connections collection
    match /connections/{connectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
    }

    // User Groups (node grouping data)
    match /userGroups/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite Codes
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Invitations
    match /invitations/{invitationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Time Slots (coffee chat)
    match /timeSlots/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Coffee Chat Requests
    match /coffeeChatRequests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Keywords
    match /keywords/{keywordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Group Invites (node group sharing)
    match /groupInvites/{inviteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Managed Groups
    match /managedGroups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Managed Group Invites
    match /managedGroupInvites/{inviteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // FCM Push Notification Tokens
    match /fcmTokens/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
