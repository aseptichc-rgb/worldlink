rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Connections collection
    match /connections/{connectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid
            || request.auth.token.email == 'kjykjj04@naver.com');
      allow delete: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
    }

    // User Groups (node grouping data)
    match /userGroups/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite Codes
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Invitations
    match /invitations/{invitationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Time Slots (coffee chat)
    match /timeSlots/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Coffee Chat Requests
    match /coffeeChatRequests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Keywords
    match /keywords/{keywordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Group Invites (node group sharing)
    match /groupInvites/{inviteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Managed Groups
    match /managedGroups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Managed Group Invites
    match /managedGroupInvites/{inviteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // FCM Push Notification Tokens
    match /fcmTokens/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Messages (쪽지)
    match /messages/{messageId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
    }

    // Public Cards (학술 프로필 카드)
    match /publicCards/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Papers (논문)
    match /papers/{paperId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.researcherId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.researcherId == request.auth.uid;
    }

    // Achievements (연구 업적)
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.researcherId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.researcherId == request.auth.uid;
    }

    // Research Labs (연구실)
    match /labs/{labId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.piId == request.auth.uid;
    }

    // Lab Invites (연구실 초대)
    match /labInvites/{inviteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Collaboration Opportunities (협업 기회)
    match /collaborations/{collaborationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.postedBy == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.postedBy == request.auth.uid;
    }

    // Paper Alerts (논문/인용 알림)
    match /paperAlerts/{alertId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
